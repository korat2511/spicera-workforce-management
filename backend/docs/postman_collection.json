        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/shifts"
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"Shifts retrieved successfully\",\n  \"data\": [\n    {\n      \"id\": 1,\n      \"name\": \"Morning Shift\",\n      \"shift_type\": \"REGULAR\",\n      \"description\": \"Breakfast & lunch rush operations\",\n      \"start_time\": \"08:00\",\n      \"end_time\": \"16:00\",\n      \"duration_hours\": 8.0,\n      \"status\": \"active\",\n      \"break_duration_minutes\": 15,\n      \"grace_period_minutes\": 10,\n      \"scheduled_days\": [\n        \"Mon\",\n        \"Tue\",\n        \"Wed\",\n        \"Thu\",\n        \"Fri\",\n        \"Sat\",\n        \"Sun\"\n      ],\n      \"staff_count\": 6,\n      \"assigned_staff\": [\n        {\n          \"id\": 101,\n          \"full_name\": \"John Smith\"\n        }\n      ]\n    }\n  ]\n}"
        }
      ]
    },
