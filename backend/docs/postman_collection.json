      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"inactive\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/staff/{{staff_id}}/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "staff",
            "{{staff_id}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "Set staff PIN",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pin\": \"123456\",\n  \"pin_confirmation\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/staff/{{staff_id}}/pin",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "staff",
            "{{staff_id}}",
            "pin"
          ]
        }
      },
      "response": [
        {
          "name": "422 PIN mismatch",
          "originalRequest": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/v1/staff/{{staff_id}}/pin"
            }
          },
          "status": "Unprocessable Content",
          "code": 422,
          "body": "{\n  \"success\": false,\n  \"message\": \"Validation failed\",\n  \"errors\": {\n    \"pin\": [\"The pin field confirmation does not match.\"]\n  }\n}"
        }
      ]
    },
    {
      "name": "Assign staff shift",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"shift_id\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/staff/{{staff_id}}/shift",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "staff",
            "{{staff_id}}",
            "shift"
          ]
        }
      }
    },
